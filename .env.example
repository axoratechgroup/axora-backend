# URL de conexión a Postgres. Formato:
# postgres://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/axora

# Secreto para firmar/verificar los JWT. Usa un valor largo y aleatorio,
# no el de otro entorno.
JWT_SECRET=cambia-este-valor-por-uno-propio

# Opcional. Orígenes permitidos por CORS, separados por coma.
# Si no se define, el default es http://localhost:5173
CORS_ORIGIN=http://localhost:5173

GEMINI_API_KEY=tu_api_key_real_de_gemini_aca